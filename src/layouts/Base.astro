---
import '../styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { profile } from '../data/profile';
import { getLocale } from '../i18n';

// Latin only: EN + ES stay inside U+0000-00FF, so the other 6 subsets fontsource
// ships would be dead weight in the (inlined) stylesheet.
const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const fontFaces = [
  { family: 'Inter Variable', url: interWoff2 },
  { family: 'JetBrains Mono Variable', url: monoWoff2 },
]
  .map(
    ({ family, url }) =>
      `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2-variations');unicode-range:${latinRange};}`
  )
  .join('');

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.currentLocale);

const {
  title = `${profile.name} — ${profile.role[locale]}`,
  description = profile.tagline[locale],
} = Astro.props;

const siteBase = Astro.site ?? 'https://diegocosta.dev';
const canonical = new URL(Astro.url.pathname, siteBase).href;
const ogImage = new URL('/og.png', siteBase).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', siteBase).href} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', siteBase).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteBase).href} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#010102" />

    <script is:inline>
      // Runs before first paint: is:inline keeps Astro from deferring it.
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
        const m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', theme === 'light' ? '#f7f8fa' : '#010102');
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={profile.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.role[locale],
        email: profile.email,
        address: { '@type': 'PostalAddress', addressLocality: profile.location },
        url: 'https://diegocosta.dev',
        sameAs: profile.socials.filter((s) => s.icon !== 'mail').map((s) => s.href),
      })}
    />
  </head>
  <body>
    <slot />
    <script>
      // Scroll-reveal via IntersectionObserver
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Active-section tracking: a section is active while it crosses the
      // 30–40% viewport band, so height never matters (threshold: 0.5 broke
      // on sections taller than 2× the viewport).
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('[data-nav-link]');
      let activeId: string | null = null;

      const setActive = (id: string | null) => {
        if (id === activeId) return;
        activeId = id;
        navLinks.forEach((l) =>
          l.toggleAttribute('data-active', l.getAttribute('data-nav-link') === id)
        );
        document.dispatchEvent(new CustomEvent('nav:active', { detail: { id } }));
      };

      // At max scroll the band can land on a section above a short final
      // section, so the bottom guard must win inside the observer too.
      const atBottom = () =>
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 4;

      const spy = new IntersectionObserver(
        (entries) => {
          if (atBottom()) {
            setActive('contact');
            return;
          }
          for (const e of entries) {
            if (e.isIntersecting) {
              const id = e.target.getAttribute('id');
              setActive(id === 'top' ? null : id);
            }
          }
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((s) => spy.observe(s));

      window.addEventListener(
        'scroll',
        () => {
          if (atBottom()) setActive('contact');
        },
        { passive: true }
      );
    </script>
  </body>
</html>
