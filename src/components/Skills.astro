---
import { skills } from '../data/skills';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---
<section id="skills" class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-28">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-subtle">{copy.skills.kicker}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-display-md text-ink sm:text-4xl">
      {copy.skills.heading}
    </h2>
    <p class="mt-4 text-ink-muted">
      {copy.skills.intro}
    </p>
  </div>

  <ul role="list" class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group) => (
        <li class="flex flex-col rounded-lg border border-hairline bg-surface-1 p-6 transition-colors hover:bg-surface-2">
          <h3 class="font-mono text-xs uppercase tracking-wide text-ink-subtle">
            {group.title[locale]}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{group.note[locale]}</p>
          <ul role="list" class="mt-5 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="inline-flex rounded-md border border-hairline px-2.5 py-1 font-mono text-sm text-ink-muted transition-colors hover:border-hairline-strong hover:text-ink">
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
