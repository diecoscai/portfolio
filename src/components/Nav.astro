---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-hairline/60 bg-canvas/70 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6 lg:px-8">
    <a href="#top" class="group flex items-center gap-2" aria-label="Diego Costa — home">
      <span class="grid h-6 w-6 place-items-center rounded-md bg-primary text-[13px] font-semibold text-on-primary">
        D
      </span>
      <span class="text-sm font-semibold tracking-tight text-ink">Diego Costa</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={`#${l.id}`}
              data-nav-link={l.id}
              class="nav-link rounded-md px-3 py-1.5 text-sm text-ink-subtle transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="#contact"
        class="rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover"
      >
        Get in touch
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-md border border-hairline text-ink-subtle transition-colors hover:text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-hairline bg-canvas/95 backdrop-blur-md md:hidden"
  >
    <ul class="mx-auto flex max-w-6xl flex-col px-6 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={`#${l.id}`}
              data-menu-link
              class="block border-b border-hairline/60 py-3 text-sm text-ink-subtle transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav-link[data-active] {
    color: var(--color-ink);
  }
  .nav-link[data-active]::after {
    content: '';
    display: block;
    height: 1.5px;
    margin-top: 3px;
    border-radius: 9999px;
    background: var(--color-primary);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  }
</script>
