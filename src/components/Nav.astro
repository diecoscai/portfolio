---
import ThemeToggle from './ThemeToggle.astro';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);

const links = [
  { id: 'about', label: copy.nav.about },
  { id: 'work', label: copy.nav.work },
  { id: 'experience', label: copy.nav.experience },
  { id: 'skills', label: copy.nav.skills },
  { id: 'contact', label: copy.nav.contact },
];
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    class="relative flex h-12 items-center gap-1 rounded-full border border-hairline bg-canvas/70 px-1.5 shadow-lg shadow-black/10 backdrop-blur-md"
    aria-label={copy.nav.ariaMain}
  >
    <a href="#top" class="flex items-center pl-1 pr-2" aria-label={copy.nav.ariaHome}>
      <span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-[13px] font-semibold text-on-primary">
        D
      </span>
    </a>

    <ul id="nav-links" class="relative hidden items-center md:flex">
      <span
        id="nav-pill"
        aria-hidden="true"
        class="absolute left-0 top-1/2 -z-10 h-8 w-0 rounded-full bg-surface-2 opacity-0"
      ></span>
      {
        links.map((l) => (
          <li>
            <a
              href={`#${l.id}`}
              data-nav-link={l.id}
              class="nav-link block rounded-full px-3 py-1.5 text-sm text-ink-subtle transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <span class="mx-1 hidden h-5 w-px bg-hairline md:block" aria-hidden="true"></span>

    <ThemeToggle />

    <a
      href="#contact"
      class="hidden rounded-full bg-primary px-3.5 py-1.5 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover sm:block"
    >
      {copy.nav.cta}
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="grid h-9 w-9 place-items-center rounded-full text-ink-subtle transition-colors hover:text-ink md:hidden"
      aria-label={copy.nav.menuOpen}
      data-label-open={copy.nav.menuOpen}
      data-label-close={copy.nav.menuClose}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="absolute left-1/2 top-[calc(100%+8px)] hidden w-[min(92vw,360px)] -translate-x-1/2 rounded-2xl border border-hairline bg-canvas/95 p-2 shadow-xl shadow-black/20 backdrop-blur-md md:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map((l) => (
          <li>
            <a
              href={`#${l.id}`}
              data-menu-link
              class="block rounded-lg px-3 py-3 text-sm text-ink-subtle transition-colors hover:bg-surface-1 hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav-link[data-active] {
    color: var(--color-ink);
  }
  #nav-pill {
    transition:
      transform 0.2s var(--ease-out-linear),
      width 0.2s var(--ease-out-linear),
      opacity 0.2s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-pill {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const labelOpen = toggle.dataset.labelOpen ?? 'Open menu';
    const labelClose = toggle.dataset.labelClose ?? 'Close menu';
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', labelOpen);
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
    });
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  }

  const pill = document.getElementById('nav-pill');
  const linksWrap = document.getElementById('nav-links');
  let currentId: string | null = null;

  const position = () => {
    if (!pill || !linksWrap) return;
    const link = currentId
      ? linksWrap.querySelector<HTMLElement>(`[data-nav-link="${currentId}"]`)
      : null;
    if (!link) {
      pill.style.opacity = '0';
      return;
    }
    pill.style.opacity = '1';
    pill.style.width = `${link.offsetWidth}px`;
    pill.style.transform = `translate(${link.offsetLeft}px, -50%)`;
  };

  document.addEventListener('nav:active', (e) => {
    currentId = (e as CustomEvent<{ id: string | null }>).detail.id;
    position();
  });
  window.addEventListener('resize', position);
</script>
