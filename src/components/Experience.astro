---
import { experience, education } from '../data/experience';
---

<section id="experience" class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-28">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-subtle">Experience</p>
    <h2 class="mt-3 text-4xl font-semibold tracking-display-md text-ink sm:text-5xl">
      Where I've been building
    </h2>
    <p class="mt-4 text-ink-muted">
      A track record of shipping production AI systems and full-stack products.
    </p>
  </div>

  <ol class="mt-14 lg:mt-16" role="list">
    {
      experience.map((role) => (
        <li class="reveal border-t border-hairline py-8 lg:py-10">
          <div class="grid gap-4 lg:grid-cols-[10rem_1fr] lg:gap-8">
            <p class="font-mono text-sm text-ink-subtle lg:pt-1">{role.period}</p>

            <div>
              <h3 class="text-lg font-semibold text-ink">{role.company}</h3>
              <p class="mt-0.5 text-ink-muted">{role.title}</p>
              <p class="mt-1 font-mono text-xs text-ink-subtle">{role.location}</p>

              <p class="mt-4 text-ink-muted">{role.summary}</p>

              <ul class="mt-4 space-y-2" role="list">
                {role.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink-muted">
                    <span class="mt-2 h-px w-3 shrink-0 bg-hairline-strong" aria-hidden="true" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-2" role="list">
                {role.tags.map((tag) => (
                  <li class="rounded-full border border-hairline px-2.5 py-1 font-mono text-xs text-ink-subtle">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="reveal mt-16 border-t border-hairline pt-10">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-subtle">Education</p>
    <ul class="mt-6 space-y-6" role="list">
      {
        education.map((entry) => (
          <li class="grid gap-1 lg:grid-cols-[10rem_1fr] lg:gap-8">
            <p class="font-mono text-sm text-ink-subtle lg:pt-0.5">{entry.period}</p>
            <div>
              <h3 class="font-semibold text-ink">{entry.school}</h3>
              <p class="mt-0.5 text-sm text-ink-muted">{entry.degree}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
