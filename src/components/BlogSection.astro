---
// Blog section with two blog cards
---

<section id="blog" class="section py-16 px-6 lg:px-24 bg-base-100 items-center">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8 max-w-6xl mx-auto w-full h-auto md:h-[60vh] md:min-h-[400px] md:max-h-[600px]">
    <!-- Life Blog Card -->
    <a href="#" class="blog-card group relative flex items-end p-8 rounded-xl overflow-hidden cursor-pointer min-h-[250px] md:min-h-0 transition-transform duration-400 hover:scale-[1.02]">
      <div class="blog-card-bg absolute inset-0 z-0 transition-transform duration-600 group-hover:scale-110 bg-gradient-to-br from-[#1a1a2e] via-[#16213e] to-[#0f3460]"></div>
      <div class="blog-card-overlay absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity duration-400"></div>

      <div class="blog-card-content relative z-20 text-white translate-y-5 transition-transform duration-400 group-hover:translate-y-0">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 tracking-tight">Life Blog</h2>
        <p class="text-sm text-white/70 leading-relaxed max-w-[90%] opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
          My journey through AI development, personal projects, hobbies, and the experiences that shape my path as a developer.
        </p>
      </div>

      <span class="blog-card-arrow absolute top-8 right-8 w-12 h-12 flex items-center justify-center border border-white/30 rounded-full text-white opacity-0 -translate-x-2 transition-all duration-400 z-20 group-hover:opacity-100 group-hover:translate-x-0 hover:bg-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>

      <span class="absolute inset-0 border-2 border-transparent rounded-xl z-30 pointer-events-none transition-colors duration-300 group-hover:border-white/20"></span>
    </a>

    <!-- Tech Blog Card -->
    <a href="#" class="blog-card group relative flex items-end p-8 rounded-xl overflow-hidden cursor-pointer min-h-[250px] md:min-h-0 transition-transform duration-400 hover:scale-[1.02]">
      <div class="blog-card-bg absolute inset-0 z-0 transition-transform duration-600 group-hover:scale-110 bg-gradient-to-br from-[#0f0f0f] via-[#1a1a1a] to-[#2d2d2d]"></div>
      <div class="blog-card-overlay absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity duration-400"></div>

      <div class="blog-card-content relative z-20 text-white translate-y-5 transition-transform duration-400 group-hover:translate-y-0">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 tracking-tight">Tech Blog</h2>
        <p class="text-sm text-white/70 leading-relaxed max-w-[90%] opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
          Technical tutorials, Claude configurations, AI agents guides, and informative posts about the tools and technologies I use.
        </p>
      </div>

      <span class="blog-card-arrow absolute top-8 right-8 w-12 h-12 flex items-center justify-center border border-white/30 rounded-full text-white opacity-0 -translate-x-2 transition-all duration-400 z-20 group-hover:opacity-100 group-hover:translate-x-0 hover:bg-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>

      <span class="absolute inset-0 border-2 border-transparent rounded-xl z-30 pointer-events-none transition-colors duration-300 group-hover:border-white/20"></span>
    </a>
  </div>
</section>
