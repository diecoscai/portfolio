---
// Fetch repositories and user profile from GitHub API at build time
interface GitHubRepo {
  name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  visibility: string;
}

interface GitHubUser {
  login: string;
  avatar_url: string;
  name: string | null;
}

// Language colors matching GitHub's color scheme
function getLanguageColor(language: string | null): string {
  if (!language) return '#858585';
  const colors: Record<string, string> = {
    JavaScript: '#f1e05a',
    TypeScript: '#3178c6',
    Python: '#3572A5',
    Go: '#00ADD8',
    Rust: '#dea584',
    Java: '#b07219',
    'C++': '#f34b7d',
    C: '#555555',
    'C#': '#178600',
    Ruby: '#701516',
    PHP: '#4F5D95',
    Swift: '#F05138',
    Kotlin: '#A97BFF',
    Shell: '#89e051',
    HTML: '#e34c26',
    CSS: '#563d7c',
    Vue: '#41b883',
    Svelte: '#ff3e00',
    Astro: '#ff5a03',
  };
  return colors[language] || '#858585';
}

let repos: GitHubRepo[] = [];
let user: GitHubUser | null = null;

try {
  const [reposResponse, userResponse] = await Promise.all([
    fetch('https://api.github.com/users/diecoscai/repos?sort=updated&per_page=6'),
    fetch('https://api.github.com/users/diecoscai')
  ]);

  if (reposResponse.ok) {
    repos = await reposResponse.json();
  }
  if (userResponse.ok) {
    user = await userResponse.json();
  }
} catch (error) {
  console.error('Failed to fetch GitHub data:', error);
}
---

<section id="projects" class="section py-16 px-6 lg:px-24 bg-base-100">
  <div class="max-w-6xl mx-auto w-full">
    <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-start gap-8 mb-12">
    <div class="max-w-md">
      <h2 class="text-3xl font-bold mb-4">Projects.</h2>
      <p class="text-sm text-secondary leading-relaxed">
        These are my open source projects fetched directly from Github.<br />
        If you're a developer, feel free to make a pull request!
      </p>
    </div>

    <!-- GitHub Profile Card -->
    <a href="https://github.com/diecoscai" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-base-200 rounded-lg w-full md:w-auto hover:bg-base-300 transition-colors">
      {user?.avatar_url ? (
        <img src={user.avatar_url} alt="GitHub avatar" class="w-12 h-12 rounded-full object-cover" />
      ) : (
        <div class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center text-base-content/50">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="w-[70%] h-[70%]">
            <circle cx="50" cy="35" r="20" fill="currentColor" opacity="0.5"/>
            <ellipse cx="50" cy="85" rx="35" ry="25" fill="currentColor" opacity="0.5"/>
          </svg>
        </div>
      )}
      <div>
        <h4 class="text-sm font-semibold">{user?.name || 'Diego Costa'}</h4>
        <span class="text-xs text-base-content/50">@{user?.login || 'diecoscai'}</span>
      </div>
    </a>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projectsGrid">
    {repos.length > 0 ? (
      repos.map((repo, index) => (
        <div class="card bg-base-100 border border-base-300 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 project-card" style={`animation-delay: ${index * 0.1}s`}>
          <div class="card-body p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-base-content/50" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z"/>
                </svg>
                <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-info hover:underline">{repo.name}</a>
              </div>
              <span class="text-xs px-2 py-0.5 border border-base-300 rounded-full text-base-content/60 capitalize">{repo.visibility}</span>
            </div>

            {repo.description && (
              <p class="text-sm text-secondary leading-relaxed mb-4">{repo.description}</p>
            )}

            <div class="flex items-center gap-4 text-xs text-base-content/50 mt-auto">
              {repo.language && (
                <span class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${getLanguageColor(repo.language)}`}></span>
                  {repo.language}
                </span>
              )}
              {repo.stargazers_count > 0 && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
                  </svg>
                  {repo.stargazers_count}
                </span>
              )}
              {repo.forks_count > 0 && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/>
                  </svg>
                  {repo.forks_count}
                </span>
              )}
            </div>
          </div>
        </div>
      ))
    ) : (
      <div class="col-span-full text-center py-12 text-base-content/50">
        <p>Unable to load projects. Visit my <a href="https://github.com/diecoscai" target="_blank" rel="noopener noreferrer" class="text-info hover:underline">GitHub profile</a> to see my work.</p>
      </div>
    )}
  </div>

  <!-- GitHub Contributions Graph -->
  <div class="mt-8 p-4 bg-base-200 rounded-lg border border-base-300">
    <div class="flex items-center justify-between gap-4 mb-3">
      <h3 class="text-xs font-medium text-base-content/70">Contributions in the last year</h3>
      <div class="flex items-center gap-1.5 text-[10px] text-base-content/50">
        <span>Less</span>
        <div class="flex gap-0.5">
          <span class="w-2 h-2 rounded-sm bg-base-300"></span>
          <span class="w-2 h-2 rounded-sm" style="background-color: #0e4429"></span>
          <span class="w-2 h-2 rounded-sm" style="background-color: #006d32"></span>
          <span class="w-2 h-2 rounded-sm" style="background-color: #26a641"></span>
          <span class="w-2 h-2 rounded-sm" style="background-color: #39d353"></span>
        </div>
        <span>More</span>
      </div>
    </div>
    <div class="overflow-x-auto">
      <img
        src="https://ghchart.rshah.org/26a641/diecoscai"
        alt="GitHub Contributions Graph for diecoscai"
        class="w-full min-w-[500px] max-h-24 object-contain contribution-graph"
        loading="lazy"
      />
    </div>
  </div>
  </div>
</section>

<style>
  .project-card {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contribution-graph {
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: 0.6s;
  }
</style>
