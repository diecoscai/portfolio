---
import { profile } from '../data/profile';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const year = new Date().getFullYear();
---
<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 py-8 text-sm text-ink-subtle sm:flex-row lg:px-8">
    <span>© {year} {profile.name}</span>
    <span class="max-w-md text-center sm:text-right">{copy.footer.claim}</span>
  </div>
</footer>
