---
import { profile } from '../data/profile';
import { getLocale, t } from '../i18n';
import Icon from './Icon.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const mailto = `mailto:${profile.email}`;
const links = profile.socials.filter((s) => s.icon !== 'mail');
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-24 lg:px-8 lg:py-28">
  <div class="reveal panel-hairline mx-auto flex flex-col items-center rounded-2xl bg-surface-1 p-10 text-center lg:p-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-subtle">{copy.contact.kicker}</p>

    <h2 class="mt-5 max-w-2xl text-3xl font-semibold tracking-display-md text-ink sm:text-4xl lg:text-5xl">
      {copy.contact.heading}
    </h2>

    <p class="mt-4 max-w-md text-base text-ink-muted">
      {copy.contact.intro}
    </p>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a
        href={mailto}
        class="inline-flex min-h-[44px] items-center gap-2 rounded-md bg-primary px-6 py-3 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover"
      >
        {copy.contact.emailMe}
        <Icon name="arrow-up-right" size={16} />
      </a>

      <a
        href={profile.cv}
        class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-hairline px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-hairline-strong hover:bg-surface-2"
      >
        {copy.contact.cv}
      </a>
    </div>

    <a
      href={mailto}
      class="mt-6 font-mono text-sm text-ink-subtle transition-colors hover:text-accent"
    >
      {profile.email}
    </a>

    <ul class="mt-10 flex items-center justify-center gap-2">
      {
        links.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-md border border-hairline text-ink-subtle transition-colors hover:bg-surface-2 hover:text-ink"
            >
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-sm font-mono text-xs leading-relaxed text-ink-subtle">
      {copy.contact.timezone}
    </p>
  </div>
</section>
